
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn()
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.admin == true;
    }

    function isOwner(field) {
      return isSignedIn()
        && field == request.auth.uid;
    }

    // ===== USERS =====
    match /users/{userId} {
      allow create: if isSignedIn()
        && request.auth.uid == userId;

      allow read, update, delete: if isOwner(userId)
        || isAdmin();
    }

    // ===== PRODUCTS =====
    match /products/{productId} {
      // Public marketplace browsing
      allow read: if true;

      // Only verified users can create products for themselves
      allow create: if isEmailVerified()
        && request.resource.data.ownerId == request.auth.uid;

      // Owners can update their own pending products
      allow update: if isOwner(resource.data.ownerId)
        && resource.data.status == "pending"
        && request.resource.data.ownerId == resource.data.ownerId;

      // Admins can update products
      allow update: if isAdmin();

      // Owners and admins can delete products
      allow delete: if isOwner(resource.data.ownerId)
        || isAdmin();
    }

    // ===== FARMS =====
    match /farms/{farmId} {
      // Public farm browsing
      allow read: if true;

      allow create: if isEmailVerified()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if (
          isOwner(resource.data.ownerId)
          && request.resource.data.ownerId == resource.data.ownerId
        ) || isAdmin();

      allow delete: if isOwner(resource.data.ownerId)
        || isAdmin();
    }

    // ===== ORDERS =====
    match /orders/{orderId} {
      allow create: if isEmailVerified()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId.size() > 0;

      allow read: if isSignedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
          || isAdmin()
        );

      // Only admins can update or delete orders.
      allow update, delete: if isAdmin();
    }

    // ===== FORUM POSTS =====
    match /forumPosts/{postId} {
      allow read: if true;

      allow create: if isEmailVerified()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if (
          isOwner(resource.data.authorId)
          && request.resource.data.authorId == resource.data.authorId
        ) || isAdmin();

      allow delete: if isOwner(resource.data.authorId)
        || isAdmin();
    }

    // ===== AUCTIONS =====
    match /auctions/{auctionId} {
      allow read: if true;

      allow create: if isEmailVerified()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if (
          isOwner(resource.data.ownerId)
          && request.resource.data.ownerId == resource.data.ownerId
        ) || isAdmin();

      allow delete: if isOwner(resource.data.ownerId)
        || isAdmin();
    }

    // ===== PUBLIC POSTS =====
    match /posts/{postId} {
      allow read: if true;

      allow create: if isEmailVerified()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if (
          isOwner(resource.data.authorId)
          && request.resource.data.authorId == resource.data.authorId
        ) || isAdmin();

      allow delete: if isOwner(resource.data.authorId)
        || isAdmin();

      // ===== COMMENTS SUBCOLLECTION =====
      match /comments/{commentId} {
        allow read: if true;

        allow create: if isEmailVerified()
          && request.resource.data.authorId == request.auth.uid;

        allow update: if (
            isOwner(resource.data.authorId)
            && request.resource.data.authorId == resource.data.authorId
          ) || isAdmin();

        allow delete: if isOwner(resource.data.authorId)
          || isAdmin();
      }
    }

    // ===== DEFAULT DENY =====
    // Any collection not explicitly covered above is denied.
  }
}
);
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // ---------- orders ----------
    match /orders/{orderId} {
      allow create: if verified() && request.resource.data.buyerId == request.auth.uid;
      allow read:   if signedIn() && (resource.data.buyerId == request.auth.uid
                                   || resource.data.sellerId == request.auth.uid
                                   || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ---------- forum ----------
    match /forumPosts/{postId} {
      allow read: if true;
      allow create: if verified() && request.resource.data.authorId == request.auth.uid;
      // Mobile stores comments/reactions inside the post, so any verified user may
      // change ONLY those two fields; everything else is author/admin only.
      allow update: if isOwner(resource.data.authorId) || isAdmin()
                    || (verified()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['comments', 'reactions']));
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }

    // ---------- auctions ----------
    match /auctions/{auctionId} {
      allow read: if true;
      allow create: if verified() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // ---------- legacy "posts" (kept from your original rules) ----------
    match /posts/{postId} {
      allow read: if true;
      allow create: if verified() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.authorId) || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if verified() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isOwner(resource.data.authorId) || isAdmin();
      }
    }

    // ---------- admin-only (used by the web admin panel) ----------
    match /adminLogs/{id}      { allow read, write: if isAdmin(); }
    match /announcements/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /platform/{id}       { allow read, write: if isAdmin(); }

    // NOTE: no catch-all rule. Your old `match /{document=**} { allow read: if true; }`
    // made users, users_private and orders publicly readable. Anything not listed
    // above is now denied.
  }
}
